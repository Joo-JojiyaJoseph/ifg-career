APP_NAME="Infolks Group Careers"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ifg-career
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# 7 days for the careers site. The portal also ends an idle HR session after 30 minutes.
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log writes messages to storage/logs. For Mailtrap use smtp and the inbox host, port and credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="careers@infolksgroup.com"
MAIL_FROM_NAME="Infolks Group"

# Sanctum SPA cookie auth. Include every frontend origin, without a scheme.
# Ask HR and Admin for an authenticator code at sign-in (true/false).
HR_REQUIRE_TWO_FACTOR=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,127.0.0.1,127.0.0.1:8000
FRONTEND_CAREERS_URL=http://localhost:5173
FRONTEND_PORTAL_URL=http://localhost:5174

# Google sign-in for candidates, and Google Calendar for interview events.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"
GOOGLE_CALENDAR_ID=
# Path to the Google service account JSON key (keep it outside public/). Share the HR calendar with the service account's email.
GOOGLE_CALENDAR_CREDENTIALS=storage/app/private/google-calendar.json
# Optional: a Google Workspace user the service account acts as (needs domain-wide delegation). Needed to invite interviewers.
GOOGLE_CALENDAR_IMPERSONATE=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# Cloudflare Turnstile secret for Quick apply and the talent community form (leave empty in local development).
TURNSTILE_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Requests per minute per IP for public read endpoints (job search, content). Applying has its own limit.
RATE_LIMIT_PUBLIC_PER_MINUTE=600

# Optional ClamAV virus scanning of resumes and images (clamd). Leave both empty to turn it off.
CLAMAV_HOST=
CLAMAV_SOCKET=
CLAMAV_TIMEOUT=10
# true = accept uploads when ClamAV is down; false = ask the person to try again.
CLAMAV_FAIL_OPEN=false
