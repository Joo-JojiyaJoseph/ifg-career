{
  "name": "career-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n careers,portal -c blue,magenta \"vite --config vite.careers.config.js\" \"vite --config vite.portal.config.js\"",
    "dev:careers": "vite --config vite.careers.config.js",
    "dev:portal": "vite --config vite.portal.config.js",
    "build": "npm run build:careers && npm run build:portal",
    "build:careers": "vite build --config vite.careers.config.js",
    "build:portal": "vite build --config vite.portal.config.js",
    "lint": "eslint .",
    "test": "vitest run",
    "preview:careers": "vite preview --config vite.careers.config.js",
    "preview:portal": "vite preview --config vite.portal.config.js",
    "prepare": "node scripts/prepare-husky.js"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^7.0.2",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-table": "^9.3.1",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "framer-motion": "^14.9.1",
    "libphonenumber-js": "^1.13.15",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
