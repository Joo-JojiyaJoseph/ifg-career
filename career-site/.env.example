# Use the same host name you open in the browser (localhost), not 127.0.0.1, for the API too.
# The apps correct localhost/127.0.0.1 mix-ups automatically during development.
VITE_API_URL=http://localhost:8000
VITE_CAREERS_URL=http://localhost:5173
VITE_PORTAL_URL=http://localhost:5174
VITE_GOOGLE_LOGIN_URL=http://localhost:8000/api/v1/auth/google/redirect
VITE_TURNSTILE_SITE_KEY=

# Development only, optional. If the API runs on its own local domain (Laravel Herd/Valet/Laragon,
# for example http://career-backend.test), set this to that address. The dev server then forwards
# /api, /sanctum and /storage, so sign-in cookies work. Leave it empty with "php artisan serve".
VITE_API_PROXY=
