# Apache / LiteSpeed (cPanel): copied into dist by the build.
# Serve real files as they are, and send every other address to index.html so the app's own pages
# (for example /jobs or /candidates/…) still open after a page refresh or from a link.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Always use https. Sign-in cookies are secure-only and the API only accepts the https address, so a page opened
    # with http:// shows "We could not reach the server". (Skipped for localhost and behind an https proxy.)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# Never cache index.html (so a new release shows at once); the hashed files in /assets can be cached for a year.
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css|woff2|svg|png|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
